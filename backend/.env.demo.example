# Local demonstration environment — see docs/DEVELOPER_RUNBOOK.md.
# scripts/demo.ps1 copies this file to .env.demo and fills APP_KEY and the DB_* credentials from your .env.
# It needs neither Redis nor a queue worker: sessions and cache are files, jobs run inline, emails go to the log.
APP_NAME=DivaWaste
APP_ENV=demo
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
FRONTEND_URL=http://localhost:4300
SANCTUM_STATEFUL_DOMAINS=localhost:4300,127.0.0.1:4300

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

HASH_DRIVER=argon2id
LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=divawaste_demo
DB_USERNAME=
DB_PASSWORD=

# Its own cookie, so this session does not collide with another DivaWaste running on localhost.
SESSION_DRIVER=file
SESSION_COOKIE=divawaste_demo_session
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# Emails. "log": every email is generated and kept on this computer, none is delivered (scripts\demo.ps1 mail).
# To receive them in a real mailbox, replace the line below by the SMTP account of a mail provider, restart the API,
# then check it with: scripts\demo.ps1 mailtest you@example.com
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.example.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-account
#   MAIL_PASSWORD=your-password
#   MAIL_FROM_ADDRESS="an-address-that-account-may-send-from@example.com"
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@divawaste.test"
MAIL_FROM_NAME="DivaWaste"

BILLING_SELLER_LEGAL_NAME="Diva Software"
BILLING_SELLER_TAX_ID=0000000X
BILLING_SELLER_COUNTRY=TN
BILLING_INVOICE_PREFIX=DW
